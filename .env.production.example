# DigitalOcean App Platform — задать в DO Console → App → Settings → Environment Variables
# DATABASE_* переменные DO подставляет автоматически через ${db.*}

NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://grove.o2cafeandrestaurant.com

DATABASE_CLIENT=postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# СЕКРЕТЫ — сгенерировать новые для production:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
