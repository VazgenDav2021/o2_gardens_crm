{
  "collectionName": "components_layout_hero_slides",
  "info": {
    "displayName": "Hero Slide",
    "icon": "picture",
    "description": "Single slide for the hero slider: background, title, subtitle, and CTA button"
  },
  "attributes": {
    "activeBackground": {
      "type": "enumeration",
      "enum": ["image", "video"],
      "default": "image"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "backgroundVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "backgroundColor": {
      "type": "customField",
      "customField": "plugin::color-picker.color"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "links": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    }
  }
}
